<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>JarvisAssistant</AssemblyName>
		<Version>1.0.0</Version>
		<Product>J.A.R.V.I.S</Product>
		<ApplicationIcon>Assets\jarvis.ico</ApplicationIcon>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<StartupObject>GUI.Program</StartupObject>
		<SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<!-- O WinForms entra só para o NotifyIcon (bandeja); sem estes, "Application" e "MessageBox" ficam ambíguos com o WPF. -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<ItemGroup>
		<None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
		<PackageReference Include="Velopack" Version="1.2.161" />
		<ProjectReference Include="..\ServiceLibrary\ServiceLibrary.csproj" />
		<Resource Include="Assets\jarvis.ico" />
	</ItemGroup>
</Project>
